{
  "name": "chess-max",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-stockfish.mjs && vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "node scripts/copy-stockfish.mjs && tsc -b && vite build",
    "build:electron": "node scripts/copy-stockfish.mjs && node scripts/build-electron-main.mjs && vite build --mode electron",
    "dist": "npm run build:electron && electron-builder",
    "dist:publish": "npm run build:electron && electron-builder --publish always",
    "gen-icons": "node scripts/gen-icons.mjs",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.2.1",
    "esbuild": "^0.23.0",
    "happy-dom": "^14.12.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.0.4"
  }
}
